[user]
    email = binghao.bhw@gmail.com
    name = Binghao Wang
[core]
    autocrlf = input
    editor = vim
[alias]
    ch = checkout
    co = commit
    st = status
    br = branch
    re = rebase
    me = merge
    hi = log --oneline --graph --decorate

[push]
    default = simple
[credential "https://github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
